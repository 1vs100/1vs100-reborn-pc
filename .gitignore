# Game content and anything generated from it: never commit.
native/assets/
native/generated/*
!native/generated/rexglue-frozen.cmake
*.xex
*.xwb
*.xsb
*.xzp
*.toc
*.avd
*.Avatar
*.AvatarAnimation
*.xtt
*.pack

# Builds and packages
# Build scratch dirs, except the vendored zstd build files CMake needs.
build/
!native/third_party/xenosrecomp/thirdparty/zstd/build/
native-avatar-build/
dist/
*.exe
*.dll
*.lib
*.obj
*.pdb
*.map
*.zip

# Player data and logs
player-data/
userdata/
outputs/
mods/_export/
*.log
launcher-settings.ini

# Linux DXC, fetched by native/CMakeLists.txt
native/third_party/xenosrecomp/thirdparty/dxc-bin/lib/x64/*.so
native/third_party/xenosrecomp/thirdparty/dxc-bin/bin/x64/dxc-linux
