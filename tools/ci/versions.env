# Toolchain pins shared by tools/ci/Dockerfile, the tools/ci scripts and the
# CI cache keys. Changing a value rebuilds the image and the caches.
CLANG_VERSION=22
LLVM_RELEASE=22.1.8
CMAKE_VERSION=3.28.3
XWIN_VERSION=0.10.0
WINSDK_VERSION=10.0.26100.0
# vsdownload.py selects the VS 2022 17.14 line, which ships toolset 14.44.
MSVC_MAJOR=17
MSVC_SELECTOR=17.14
MSVC_TOOLSET=14.44
MSVC_WINE_COMMIT=514f8ea34842cd6d831804d0e9658d3a32870ae1
MSIX_PACKAGING_COMMIT=25a65f5c1690930813bcc10cdf1d59fa865f2bb1
# msix-packaging needs CMake 3.29 or newer.
MSIX_CMAKE_VERSION=3.31.6
# Local osxcross builds only (tools/mac/README.md); the macOS SDK cannot be
# redistributed, so CI builds macOS on macOS runners.
OSXCROSS_VERSION=27d21e4977c9751d01199c7a226a6faf494c3dd9
MACOS_SDK_VERSION=15.1
